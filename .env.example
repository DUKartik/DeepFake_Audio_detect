# .env.example — Copy to .env and fill in your values before running locally.
# NEVER commit .env to git.

# ── WhatsApp Cloud API ──────────────────────────────────────────────────────
WA_TOKEN=your_whatsapp_permanent_access_token
PHONE_NUMBER_ID=your_phone_number_id
VERIFY_TOKEN=choose_any_secret_string
APP_SECRET=your_meta_app_secret

# ── Redis (Upstash free tier) ───────────────────────────────────────────────
REDIS_URL=rediss://default:password@hostname.upstash.io:6379

# ── Cloudflare R2 ────────────────────────────────────────────────────────────
R2_BUCKET=verivoice-audit
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key

# ── ML Models ────────────────────────────────────────────────────────────────
AASIST_MODEL_PATH=./weights/AASIST.pth
XLSR_MODEL_ID=facebook/wav2vec2-xls-r-300m
USE_GPU=true                  # Set false on Render.com CPU free tier

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_DAILY=10

# ── Admin Dashboard ──────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password

# ── Misc ─────────────────────────────────────────────────────────────────────
TMP_DIR=/tmp/verivoice
LOG_LEVEL=INFO
FACT_CHECKER_URL=https://factchecker.in
